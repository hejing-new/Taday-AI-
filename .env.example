# ==========================================
# Taday 金融智能体 — 环境变量配置
# 复制此文件为 .env 并填写你的 API Key
# ==========================================

# SiliconFlow Embedding API（用于向量检索）
BASE_URL=https://api.siliconflow.cn/v1
API_KEY=your_siliconflow_api_key_here

# LongCat Chat API（用于对话和工具调用）
LONGCAT_API_KEY=your_longcat_api_key_here
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1

# Tavily Search API（用于联网搜索，可选）
TAVILY_API_KEY=your_tavily_api_key_here

# 管理员认证（B 端管理后台）
ADMIN_USER=admin
ADMIN_PASS=your_secure_password_here

# Cross-Encoder 精排（可选，设为 1 启用）
# USE_CROSS_ENCODER=1
